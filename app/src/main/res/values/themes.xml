<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Pure black + white, SF Pro Rounded. -->
    <style name="Theme.MwalletApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorPrimaryVariant">@color/text_primary</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorSecondary">@color/text_primary</item>
        <item name="colorSecondaryVariant">@color/text_primary</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorAccent">@color/text_primary</item>
        <item name="android:colorBackground">@color/surface_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/surface_background</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/surface_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:fontFamily">@font/sf_pro_rounded_family</item>
    </style>

    <style name="Theme.Transparent" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.MwalletApp.BottomSheetDialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="dialogCornerRadius">@dimen/m3_alert_dialog_corner_size</item>
        <item name="android:windowBackground">@drawable/background_bottom_sheet_dialog_daynight</item>
    </style>

    <style name="DialogWindowAnimations" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/slide_in_from_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_to_bottom</item>
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_from_bottom</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_to_bottom</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_from_bottom</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_to_bottom</item>
    </style>

    <!-- BottomSheetDialog theme. windowIsFloating must NOT be set here — Material3's
         BottomSheetDialog implementation expects a non-floating window so it can dock
         the sheet to the bottom edge with the standard drag handle. Keeping it floating
         causes the sheet to render as a centered Dialog. -->
    <style name="Theme.MwalletApp.BottomSheetDialog2" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Theme.MwalletApp.BottomSheet</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface_elevated</item>
    </style>

    <style name="Theme.MwalletApp.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_elevated</item>
        <item name="shapeAppearanceOverlay">@style/Theme.MwalletApp.BottomSheet.Shape</item>
    </style>

    <style name="Theme.MwalletApp.BottomSheet.Shape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Theme.MwalletApp.BottomSheetDialog3" parent="Theme.Material3.DayNight.Dialog">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="dialogCornerRadius">@dimen/m3_alert_dialog_corner_size</item>
        <item name="android:windowBackground">@drawable/background_bottom_sheet_dialog_material_daynight</item>
    </style>

    <!-- Primary CTA — white pill, black text -->
    <style name="Theme.MwalletApp.Button">
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:fontFamily">@font/sf_pro_rounded_family</item>
        <item name="android:textFontWeight" tools:targetApi="p">600</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.005</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Secondary — outlined ghost button, white text -->
    <style name="Theme.MwalletApp.Button.Outlined" parent="Theme.MwalletApp.Button">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/button_secondary</item>
    </style>

    <style name="Theme.MwalletApp.Button.Ghost" parent="Theme.MwalletApp.Button">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/button_ghost</item>
    </style>

    <style name="Theme.MwalletApp.Header" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/sf_pro_rounded_family</item>
        <item name="android:textFontWeight" tools:targetApi="p">700</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="Theme.MwalletApp.Header2" parent="Theme.MwalletApp.Header">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Theme.MwalletApp.Header3" parent="Theme.MwalletApp.Header2">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Theme.MwalletApp.Display" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/sf_pro_rounded_family</item>
        <item name="android:textFontWeight" tools:targetApi="p">700</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textSize">48sp</item>
    </style>

    <style name="Theme.MwalletApp.Subtitle" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/sf_pro_rounded_family</item>
        <item name="android:textFontWeight" tools:targetApi="p">500</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Theme.MwalletApp.Body" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/sf_pro_rounded_family</item>
        <item name="android:textFontWeight" tools:targetApi="p">500</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Theme.MwalletApp.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:fontFamily">@font/sf_pro_rounded_family</item>
        <item name="android:textFontWeight" tools:targetApi="p">500</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Monospace stays monospace — addresses and signatures need fixed-width -->
    <style name="Theme.MwalletApp.Mono" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Soft white pill behind the selected bottom-nav item -->
    <style name="Theme.MwalletApp.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#1FFFFFFF</item>
    </style>
</resources>
