<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#FF1A0F2E"
                android:centerColor="#FF2C1957"
                android:endColor="#FF4415BA"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#33B388FF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
