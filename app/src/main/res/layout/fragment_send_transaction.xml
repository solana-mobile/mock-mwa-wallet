<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_bottom_sheet_dialog_daynight"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="20dp"
    tools:context=".ui.sendtransaction.SendTransactionFragment">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/background_handle" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/label_send_transaction"
        style="@style/Theme.MwalletApp.Header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/label_send_transactions"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/background_card_flat"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_cluster"
            style="@style/Theme.MwalletApp.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_cluster" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_cluster"
            style="@style/Theme.MwalletApp.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            tools:text="solana:devnet" />
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="16dp"
        android:indeterminate="true"
        app:indicatorColor="@color/brand_violet_light"
        app:trackColor="@color/surface_chip" />
</LinearLayout>
