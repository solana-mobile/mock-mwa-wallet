<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingBottom="96dp"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <!-- Top bar: avatar + wallet label + network chip + QR icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/background_avatar_violet" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Theme.MwalletApp.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_main_wallet"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_lock_status"
                    style="@style/Theme.MwalletApp.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    tools:text="@string/label_locked" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/network_chip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/background_chip_devnet"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <View
                    android:id="@+id/network_chip_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/background_avatar_violet"
                    android:backgroundTint="@color/cluster_devnet" />

                <TextView
                    android:id="@+id/network_chip_label"
                    style="@style/Theme.MwalletApp.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/text_primary"
                    tools:text="Devnet" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_scan_qr"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/background_action_circle"
                android:contentDescription="@string/label_menu_qr_scan"
                android:padding="9dp"
                android:src="@drawable/ic_qr_24"
                android:tint="@color/text_primary" />
        </LinearLayout>

        <!-- HERO CARD: total balance + pubkey + copy/explorer -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/background_hero_card"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="22dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Theme.MwalletApp.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_total_balance"
                        android:textColor="#B0FFFFFF" />

                    <ImageButton
                        android:id="@+id/btn_refresh"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_refresh_24"
                        android:tint="#CCFFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_balance"
                        style="@style/Theme.MwalletApp.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        tools:text="2.3457" />

                    <TextView
                        style="@style/Theme.MwalletApp.Header3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="8dp"
                        android:text="SOL"
                        android:textColor="#CCFFFFFF" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_balance_subtitle"
                    style="@style/Theme.MwalletApp.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#A0FFFFFF"
                    tools:text="Devnet · network testnet SOL" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="#33FFFFFF" />

                <!-- Pubkey row -->
                <LinearLayout
                    android:id="@+id/pubkey_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Theme.MwalletApp.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_pubkey"
                            android:textColor="#90FFFFFF" />

                        <TextView
                            android:id="@+id/text_pubkey"
                            style="@style/Theme.MwalletApp.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            tools:text="9xQe…uHe2" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btn_copy"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/background_action_circle"
                        android:contentDescription="@string/label_copy"
                        android:src="@drawable/ic_copy_16"
                        android:tint="@color/text_primary" />

                    <ImageButton
                        android:id="@+id/btn_explorer"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/background_action_circle"
                        android:contentDescription="@string/label_explorer"
                        android:src="@drawable/ic_external_link_24"
                        android:tint="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Quick actions: Send / Receive / Swap / Buy -->
        <LinearLayout
            android:id="@+id/quick_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/action_send"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/background_action_circle"
                    android:contentDescription="@string/action_send"
                    android:padding="16dp"
                    android:src="@drawable/ic_send_24"
                    android:tint="@color/text_primary" />

                <TextView
                    style="@style/Theme.MwalletApp.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_send"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_receive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/background_action_circle"
                    android:contentDescription="@string/action_receive"
                    android:padding="16dp"
                    android:src="@drawable/ic_receive_24"
                    android:tint="@color/text_primary" />

                <TextView
                    style="@style/Theme.MwalletApp.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_receive"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_swap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/background_action_circle"
                    android:contentDescription="@string/action_swap"
                    android:padding="16dp"
                    android:src="@drawable/ic_swap_24"
                    android:tint="@color/text_primary" />

                <TextView
                    style="@style/Theme.MwalletApp.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_swap"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_buy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/background_action_circle"
                    android:contentDescription="@string/action_buy"
                    android:padding="16dp"
                    android:src="@drawable/ic_buy_24"
                    android:tint="@color/text_primary" />

                <TextView
                    style="@style/Theme.MwalletApp.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_buy"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Authentication card (shown when no key yet) -->
        <LinearLayout
            android:id="@+id/auth_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/background_action_circle"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_fingerprint_24"
                    android:tint="@color/brand_violet_light" />

                <TextView
                    style="@style/Theme.MwalletApp.Header3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/label_authenticate_unlock"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <TextView
                style="@style/Theme.MwalletApp.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/label_authenticate_subtitle" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_authenticate"
                style="@style/Theme.MwalletApp.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_authenticate" />
        </LinearLayout>

        <!-- Airdrop banner (only visible on Devnet/Testnet) -->
        <LinearLayout
            android:id="@+id/airdrop_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/background_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/background_action_circle"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_down_in"
                android:tint="@color/accent_success" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Theme.MwalletApp.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_devnet_funded"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_airdrop_subtitle"
                    style="@style/Theme.MwalletApp.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free test SOL for development" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_airdrop"
                style="@style/Theme.MwalletApp.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="0dp"
                android:paddingHorizontal="14dp"
                android:text="+1 SOL"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- No-wallet hint -->
        <LinearLayout
            android:id="@+id/no_wallet_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                style="@style/Theme.MwalletApp.Header3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_no_wallet_title" />

            <TextView
                style="@style/Theme.MwalletApp.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_no_wallet_body" />
        </LinearLayout>

        <!-- Recent activity section -->
        <LinearLayout
            android:id="@+id/recent_activity_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Theme.MwalletApp.Header3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_recent_activity" />

            <TextView
                android:id="@+id/btn_view_all_activity"
                style="@style/Theme.MwalletApp.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:padding="4dp"
                android:text="@string/label_view_all"
                android:textColor="@color/brand_violet_light" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/recent_activity_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/background_card">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recent_activity_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/recent_activity_loading"
                style="@style/Theme.MwalletApp.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="32dp"
                android:text="@string/label_loading_activity" />

            <LinearLayout
                android:id="@+id/recent_activity_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    style="@style/Theme.MwalletApp.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_no_activity_title" />

                <TextView
                    style="@style/Theme.MwalletApp.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/label_no_activity_body" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
