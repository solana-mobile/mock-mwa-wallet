<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="32dp"
        android:paddingEnd="32dp"
        android:paddingStart="32dp"
        android:paddingTop="144dp">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Name: wallet name" />

        <TextView
            android:id="@+id/public_key_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textIsSelectable="true"
            android:textSize="12sp"
            tools:text="Address: 11111111111111111111111111111111" />

        <TextView
            android:id="@+id/derived_wallets_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textIsSelectable="true"
            android:textSize="12sp"
            tools:text="m/44'/501'/0'\n11111111111111111111111111111111" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/import_seed_phrase_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Import seed phrase" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/derive_next_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Derive next wallet" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Authenticate" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/show_seed_phrase_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Show seed phrase" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/reset_storage_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Reset storage" />

    </LinearLayout>

</ScrollView>
