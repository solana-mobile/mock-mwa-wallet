<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/associate"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_bottom_sheet_dialog_daynight"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="32dp"
    tools:context=".ui.associate.AssociateFragment">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        app:indicatorColor="@color/brand_violet_light"
        app:trackColor="@color/surface_chip" />

    <TextView
        style="@style/Theme.MwalletApp.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Establishing secure session…" />
</LinearLayout>
