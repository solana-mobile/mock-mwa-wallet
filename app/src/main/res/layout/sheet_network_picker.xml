<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_bottom_sheet_dialog_daynight"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="32dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/background_handle" />

    <TextView
        style="@style/Theme.MwalletApp.Header2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/label_network" />

    <LinearLayout
        android:id="@+id/network_devnet_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/background_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/background_avatar_violet"
            android:backgroundTint="@color/cluster_devnet" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Theme.MwalletApp.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_devnet"
                android:textStyle="bold" />

            <TextView
                style="@style/Theme.MwalletApp.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="api.devnet.solana.com" />
        </LinearLayout>

        <ImageView
            android:id="@+id/network_devnet_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_24"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/network_mainnet_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/background_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/background_avatar_violet"
            android:backgroundTint="@color/cluster_mainnet" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Theme.MwalletApp.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_mainnet"
                android:textStyle="bold" />

            <TextView
                style="@style/Theme.MwalletApp.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="api.mainnet-beta.solana.com" />
        </LinearLayout>

        <ImageView
            android:id="@+id/network_mainnet_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_24"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/network_testnet_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/background_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/background_avatar_violet"
            android:backgroundTint="@color/cluster_testnet" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Theme.MwalletApp.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_testnet"
                android:textStyle="bold" />

            <TextView
                style="@style/Theme.MwalletApp.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="api.testnet.solana.com" />
        </LinearLayout>

        <ImageView
            android:id="@+id/network_testnet_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_24"
            android:visibility="invisible" />
    </LinearLayout>
</LinearLayout>
